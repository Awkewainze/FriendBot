{
    "name": "friend_bot",
    "version": "1.1.0",
    "description": "Discord bot for a memey server",
    "repository": {
        "url": "https://github.com/Awkewainze/FriendBot"
    },
    "scripts": {
        "build": "tsc",
        "ts-watch": "tsc -w",
        "start": "npm run build && node dist/index.js",
        "start:debug": "npm start -- -debug",
        "start:autoreload": "nodemon --watch src --ext ts,json --exec \"npm start\"",
        "dev": "nodemon --watch src --ext ts,json --exec \"npm run start:debug\"",
        "demon": "nodemon dist/index.js",
        "test": "npx jest",
        "lint": "eslint ./src --ext .ts --quiet --fix",
        "lint-nofix": "eslint ./src --ext .ts --quiet",
        "docs": "typedoc --excludePrivate --excludeExternals --out docs src/index.ts --theme default"
    },
    "author": "A group of friends",
    "license": "MIT",
    "dependencies": {
        "@awkewainze/checkverify": "^1.0.3",
        "@awkewainze/simpleduration": "^1.0.1",
        "@awkewainze/simpletimer": "^1.0.0",
        "@discordjs/opus": "^0.7.0",
        "@discordjs/voice": "^0.8.0",
        "axios": "^0.26.1",
        "bufferutil": "^4.0.6",
        "bytes": "^3.1.2",
        "discord-api-types": "^0.31.1",
        "discord.js": "^13.6.0",
        "erlpack": "^0.1.4",
        "ffmpeg-static": "^5.0.0",
        "libsodium-wrappers": "^0.7.10",
        "luxon": "^2.3.1",
        "md5": "^2.3.0",
        "music-metadata": "^7.12.3",
        "node-graceful-shutdown": "^1.1.2",
        "parse-duration": "^1.0.2",
        "redis": "^3.1.2",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.5.5",
        "sharp": "^0.30.3",
        "sqlite": "^4.0.25",
        "sqlite3": "^5.0.3",
        "timezones-list": "^3.0.1",
        "tiny-typed-emitter": "^2.1.0",
        "tsyringe": "^4.6.0",
        "utf-8-validate": "^5.0.9",
        "uuid": "^8.3.2",
        "winston": "^3.7.2",
        "youtube-dl-exec": "^2.0.11",
        "ytdl-core": "^4.11.0",
        "ytpl": "^2.3.0",
        "ytsr": "^3.7.0",
        "zlib-sync": "^0.1.7"
    },
    "devDependencies": {
        "@types/bytes": "^3.1.1",
        "@types/jest": "^27.4.1",
        "@types/luxon": "^2.3.1",
        "@types/md5": "^2.3.2",
        "@types/node": "^17.0.24",
        "@types/redis": "^2.8.28",
        "@types/sharp": "^0.30.2",
        "@types/sqlite3": "^3.1.8",
        "@types/uuid": "^8.3.4",
        "@typescript-eslint/eslint-plugin": "^5.19.0",
        "@typescript-eslint/parser": "^5.19.0",
        "eslint": "^8.13.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "jest": "^27.5.1",
        "nodemon": "^2.0.15",
        "prettier": "^2.6.2",
        "source-map-support": "^0.5.21",
        "ts-jest": "^27.1.4",
        "ts-node": "^10.7.0",
        "tslib": "^2.3.1",
        "typescript": "^4.6.3"
    }
}
