meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: https://discord.com/api/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{client_id}}
  password: {{client_secret}}
}

body:form-urlencoded {
  grant_type: authorization_code
  code: 
  redirect_url: 
}

docs {
  Body must be Form URL Encoded
  
  grant_type can be `authorization_code` or `token`
}
